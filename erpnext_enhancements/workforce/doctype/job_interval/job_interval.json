  },
  {
   "default": "Required",
   "description": "Not Required = the capture gate was off when this interval closed. Required = open and not yet satisfied. Captured = at least the configured minimum number of photos exist (Pending uploads count). Skipped = closed with a recorded reason. Set by the server in workforce/photo_gate.py, never by the client.",
   "fieldname": "photo_status",

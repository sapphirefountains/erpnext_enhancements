  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Requested\nSigned\nDeclined",
   "default": "Requested",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "sign_section",
   "fieldtype": "Section Break",
   "label": "Their agreement",
   "description": "The difference between “the page was open” and “they agreed”, which is the whole evidentiary value. The training module already records that somebody opened and read a document; this records that they said yes to it."
  },
  {
   "fieldname": "signed_name",
   "fieldtype": "Data",
   "label": "Typed name",
   "read_only": 1,
   "description": "Typed by them, at the moment of signing. Compared against their own name by the endpoint — a signature that does not match the signer is not one."
  },
  {
   "fieldname": "signature",
   "fieldtype": "Signature",
   "label": "Signature",
   "read_only": 1
  },
  {
   "fieldname": "column_break_sign",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "signed_on",
   "fieldtype": "Datetime",
   "label": "Signed",
   "read_only": 1
  },
  {
   "fieldname": "signed_from_ip",
   "fieldtype": "Data",
   "label": "From",
   "read_only": 1,
   "description": "Recorded because an acknowledgement with no trace of where it came from is easy to dispute and hard to defend."
  },
  {
   "fieldname": "declined_reason",
   "fieldtype": "Small Text",
   "label": "If they declined",
   "description": "Declining is allowed and recorded. A register that only accepts yes is a register that gets a yes."
  }

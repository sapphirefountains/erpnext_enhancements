  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "HR-ACK-.YYYY.-.####",
   "reqd": 1,
   "default": "HR-ACK-.YYYY.-.####",
   "print_hide": 1
  },
  {
   "fieldname": "policy",
   "fieldtype": "Data",
   "label": "Policy",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "The handbook, the vehicle policy, the safety rules. Plain text rather than a Link, because the document itself lives in Drive and a register that can only name documents already in ERPNext is a register nobody uses."
  },
  {
   "fieldname": "version_label",
   "fieldtype": "Data",
   "label": "Version",
   "in_list_view": 1,
   "description": "Which revision they agreed to. Without it, “he signed the handbook” says nothing about which handbook."
  },
  {
   "fieldname": "document_url",
   "fieldtype": "Data",
   "label": "Where it is"
  },
  {
   "fieldname": "column_break_head",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "employee",
   "fieldtype": "Link",
   "label": "Employee",
   "options": "Employee",
   "reqd": 1,
   "in_list_view": 1,
   "search_index": 1
  },
  {
   "fieldname": "employee_name",
   "fieldtype": "Data",
   "label": "Name",

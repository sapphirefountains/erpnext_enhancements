  },
  {
   "fieldname": "rescue_plan_confirmed",
   "fieldtype": "Check",
   "label": "Rescue plan in place",
   "default": "0"
  },
  {
   "fieldname": "communication_method",
   "fieldtype": "Data",
   "label": "How you stay in contact",
   "description": "Radio, voice, rope signal. The attendant has to know the entrant is still all right without going in."
  },

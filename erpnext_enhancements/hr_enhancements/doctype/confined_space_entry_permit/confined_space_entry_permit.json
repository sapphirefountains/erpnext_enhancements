  {
   "fieldname": "column_break_head",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "opened_on",
   "fieldtype": "Datetime",
   "label": "Opened",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "expires_on",
   "fieldtype": "Datetime",
   "label": "Expires",
   "read_only": 1,
   "description": "A permit is for THIS entry, not for the day. It expires after the shift so nobody works under yesterday's."
  },
  {
   "fieldname": "closed_on",
   "fieldtype": "Datetime",
   "label": "Closed",
   "read_only": 1
  },
  {
   "fieldname": "people_section",
   "fieldtype": "Section Break",
   "label": "Who",
   "description": "Three roles, and the attendant is the one that gets skipped. Nobody goes in without somebody outside."
  },
  {
   "fieldname": "entrant",
   "fieldtype": "Link",
   "label": "Entrant",
   "options": "Employee",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "entrant_name",
   "fieldtype": "Data",
   "label": "Entrant name",
   "read_only": 1,
   "fetch_from": "entrant.employee_name"
  },
  {
   "fieldname": "column_break_people",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "attendant",
   "fieldtype": "Link",
   "label": "Attendant (stays outside)",
   "options": "Employee",
   "reqd": 1,
   "description": "Stays outside for the whole entry and never enters to rescue. Most confined-space fatalities are would-be rescuers."
  },
  {
   "fieldname": "supervisor",
   "fieldtype": "Link",
   "label": "Entry supervisor",
   "options": "Employee",
   "reqd": 1
  },
  {
   "fieldname": "atmosphere_section",
   "fieldtype": "Section Break",
   "label": "Atmosphere",
   "description": "Tested BEFORE the hatch opens and before anybody goes down. A reading taken after entry is a reading taken too late."
  },
  {
   "fieldname": "oxygen_pct",
   "fieldtype": "Float",
   "label": "Oxygen %",
   "reqd": 1,
   "precision": "1",
   "description": "19.5% to 23.5%. Below is deficient, above is an enrichment fire risk. Pre-entry reading. Re-test periodically — the atmosphere in a pit is not a constant."
  },
  {
   "fieldname": "lel_pct",
   "fieldtype": "Float",
   "label": "LEL %",
   "precision": "1",
   "description": "Under 10%. Pre-entry reading. Re-test periodically — the atmosphere in a pit is not a constant."
  },
  {
   "fieldname": "column_break_atmos",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "h2s_ppm",
   "fieldtype": "Float",
   "label": "H₂S ppm",
   "precision": "1",
   "description": "Under 10 ppm. Decomposing organic matter in a wet basin makes it. Pre-entry reading. Re-test periodically — the atmosphere in a pit is not a constant."
  },
  {
   "fieldname": "co_ppm",
   "fieldtype": "Float",
   "label": "CO ppm",
   "precision": "1",
   "description": "Under 25 ppm. Pre-entry reading. Re-test periodically — the atmosphere in a pit is not a constant."
  },
  {
   "fieldname": "tested_with",
   "fieldtype": "Data",
   "label": "Meter used",
   "description": "Which meter, so a bad calibration can be traced to every entry it cleared."
  },
  {
   "fieldname": "atmosphere_ok",
   "fieldtype": "Check",
   "label": "Atmosphere within limits",
   "read_only": 1,
   "description": "DERIVED from the readings above. Never typed."
  },
  {
   "fieldname": "controls_section",
   "fieldtype": "Section Break",
   "label": "Before anybody goes in"
  },
  {
   "fieldname": "isolation_confirmed",
   "fieldtype": "Check",
   "label": "Energy isolated and locked",
   "default": "0"
  },
  {
   "fieldname": "lockout_procedure",
   "fieldtype": "Link",
   "label": "Lockout procedure",
   "options": "Lockout Tagout Procedure"
  },
  {
   "fieldname": "ventilation",
   "fieldtype": "Check",
   "label": "Ventilation running",
   "default": "0"
  },
  {
   "fieldname": "column_break_controls",

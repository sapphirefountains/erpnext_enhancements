   "fieldname": "maintenance_record",
   "fieldtype": "Link",
   "label": "Visit",
   "options": "Sapphire Maintenance Record"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nOpen\nClosed\nCanceled",
   "default": "Draft",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Moves only through the buttons. Canceled with one l, house style."

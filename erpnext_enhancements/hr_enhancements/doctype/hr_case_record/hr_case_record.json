   "in_list_view": 1,
   "search_index": 1
  },
  {
   "fieldname": "employee_name",
   "fieldtype": "Data",
   "label": "Name",
   "read_only": 1,
   "fetch_from": "employee.employee_name",
   "in_list_view": 1
  },
  {
   "fieldname": "case_type",
   "fieldtype": "Select",
   "label": "Kind",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "options": "Conversation\nWritten warning\nFinal warning\nGrievance raised\nInvestigation\nOther",
   "description": "“Conversation” is a real and useful entry, not a lesser one. Most of what belongs here is a conversation somebody wants a dated note of."
  },
  {
   "fieldname": "column_break_head",
   "fieldtype": "Column Break"
  },
  {

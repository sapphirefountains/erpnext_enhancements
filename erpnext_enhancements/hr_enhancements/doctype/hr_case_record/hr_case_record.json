   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "raised_by",
   "fieldtype": "Link",
   "label": "Raised by",
   "options": "User",
   "read_only": 1,
   "description": "Who filed it. Stamped on insert and never editable — a dated record whose author can be changed is not a record."
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Open\nClosed",
   "default": "Open",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "what_section",
   "fieldtype": "Section Break",
   "label": "What was said"
  },
  {
   "fieldname": "present",
   "fieldtype": "Small Text",
   "label": "Who was present",
   "description": "Names, plainly. The first thing anybody asks about a warning is who else was in the room."
  },
  {
   "fieldname": "summary",
   "fieldtype": "Text",
   "label": "What was said",
   "reqd": 1,
   "description": "Written for the person it is about to read back. Anything you would not say to their face does not belong in a record they can be shown in a tribunal."
  },
  {
   "fieldname": "column_break_what",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "agreed",
   "fieldtype": "Text",
   "label": "What was agreed",
   "description": "The half that makes the record useful later. A warning with no agreed next step is a warning nobody can follow up."
  },
  {
   "fieldname": "follow_up_on",
   "fieldtype": "Date",
   "label": "Follow up on"
  },
  {
   "fieldname": "evidence_section",
   "fieldtype": "Section Break",
   "label": "Attachments"
  },
  {
   "fieldname": "attachment",

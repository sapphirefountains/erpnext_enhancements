  {
   "fieldname": "section_what",
   "fieldtype": "Section Break",
   "label": "What changed"
  },
  {
   "fieldname": "cause",
   "fieldtype": "Select",
   "label": "Cause",
   "options": "\nCustomer Request\nSapphire Error\nSubcontractor\nSite Condition\nDesign Error\nCode or Inspector",
   "reqd": 1,
   "in_standard_filter": 1,
   "description": "Who or what caused this change. The one thing a contract revision count can never tell you, and the reason this is a record rather than a revision."
  },
  {
   "fieldname": "client_request_description",
   "fieldtype": "Text Editor",
   "label": "What the customer asked for",
   "reqd": 1
  },
  {
   "fieldname": "scope_addendum",
   "fieldtype": "Text Editor",
   "label": "What is being added or removed"
  },
  {
   "fieldname": "excluded_from_addendum",
   "fieldtype": "Small Text",
   "label": "Explicitly still excluded",
   "description": "What this change order does NOT cover, said out loud. The absence of that sentence is how a change order becomes an argument."
  },
  {
   "fieldname": "section_impact",
   "fieldtype": "Section Break",
   "label": "Impact"
  },
  {
   "fieldname": "cost_impact",
   "fieldtype": "Currency",
   "label": "Cost impact",
   "description": "Signed. Positive adds to the contract, negative is a credit back to the customer. One number, so a credit cannot be totalled as an addition."
  },
  {
   "fieldname": "cost_impact_type",
   "fieldtype": "Data",
   "label": "Impact type",
   "read_only": 1,
   "description": "Read from the sign of the figure above."
  },
  {
   "fieldname": "cost_basis",
   "fieldtype": "Small Text",
   "label": "How the figure was arrived at",
   "description": "Quantities, rates or the quote it came from. A number nobody can reconstruct is a number nobody can defend."
  },
  {
   "fieldname": "column_break_impact",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "schedule_impact_days",
   "fieldtype": "Int",
   "label": "Schedule impact (days)",
   "description": "Calendar days added to the programme. Negative if it saves time."
  },
  {
   "fieldname": "revised_completion_date",
   "fieldtype": "Date",
   "label": "Revised completion date"
  },
  {

   "fieldtype": "Link",
   "label": "Project",
   "options": "Project",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "co_number",
   "fieldtype": "Int",
   "label": "Change order number",
   "read_only": 1,
   "description": "Sequential within this project, not a global counter."
  },
  {
   "fieldname": "scope_of_work",
   "fieldtype": "Link",
   "label": "Scope of work",
   "options": "Project Scope of Work",
   "description": "The locked scope this change order amends."
  },
  {
   "fieldname": "column_break_head",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nPending Approval\nLocked\nExecuted\nCanceled",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Derived from the approvals and whether it is submitted. Never typed."
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer",
   "options": "Customer",
   "read_only": 1,
   "fetch_from": "project.customer"
  },
  {
   "fieldname": "transaction_date",
   "fieldtype": "Date",
   "label": "Raised on",
   "default": "Today"

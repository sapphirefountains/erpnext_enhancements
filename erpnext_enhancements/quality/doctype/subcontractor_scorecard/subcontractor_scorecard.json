   "label": "Measurability",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "options": "\nNot Measurable\nPartially Measured\nMeasured",
   "description": "How much of the picture the score came from. Always read beside the score, never instead of it."
  },
  {
   "fieldname": "score_display",
   "fieldtype": "Data",
   "label": "Score",
   "read_only": 1,
   "in_list_view": 1,
   "description": "The number and its footing, in one sentence. This is the field to read and to print; the numeric ones below exist for charting."
  },

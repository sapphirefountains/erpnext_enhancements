  {
   "fieldname": "result_intro",
   "fieldtype": "HTML",
   "options": "<p class=\"text-muted small\">The score is the proportion of <i>judgeable</i> measures that met their threshold &mdash; deliberately a count, not a weighted composite. Weights are judgements disguised as arithmetic and nobody has agreed any; a threshold is a single figure somebody can argue with. <b>A scorecard with nothing judgeable has no score at all</b>, and reads <i>Not Measurable</i> rather than zero or a hundred.</p>"
  },
  {
   "fieldname": "state",

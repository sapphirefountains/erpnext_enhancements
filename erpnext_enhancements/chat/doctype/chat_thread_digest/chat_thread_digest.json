   "unique": 1
  },
  {
   "description": "Denormalised from the thread root, for the same reason Chat Attachment.room is: the retrieval gate filters on room in the WHERE clause, and it must not have to join through Chat Message to find out which room a digest belongs to. Backfilled by the controller so a caller cannot get it wrong.",
   "fieldname": "room",
   "fieldtype": "Link",
   "in_standard_filter": 1,
   "label": "Room",
   "options": "Chat Room",
   "read_only": 1,
   "reqd": 1
